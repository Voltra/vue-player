{
	"name": "@voltra/vue-player",
	"version": "0.0.8",
	"description": "A Vue port of react-player: components for playing a variety of URLs including file paths, YouTube, Facebook, Twitch, SoundCloud, Streamable, Vimeo, Wistia, DailyMotion",
	"main": "dist/cjs/index.js",
	"umd:main": "dist/umd/index.js",
	"unpkg": "dist/umd/index.js",
	"module": "dist/esm/index.js",
	"types": "types/index.d.ts",
	"exports": {
		".": {
			"import": "./dist/esm/index.js",
			"require": "./dist/cjs/index.js"
		},
		"index.css": {
			"import": "./dist/esm/index.css",
			"require": "./dist/cjs/index.css"
		}
	},
	"scripts": {
		"build": "rollup -c",
		"watch": "npm run build -- --watch",
		"clean": "rm -rf dist"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Voltra/vue-player.git"
	},
	"keywords": [
		"vue",
		"media",
		"player",
		"video",
		"audio",
		"youtube",
		"facebook",
		"twitch",
		"soundcloud",
		"streamable",
		"vimeo",
		"wistia",
		"dailymotion",
		"hls",
		"dash",
		"vue-component"
	],
	"author": "Voltra <ludwig.guerin.98@gmx.fr>",
	"license": "MIT",
	"bugs": {
		"url": "https://github.com/Voltra/vue-player/issues"
	},
	"homepage": "https://voltra.github.io/vue-player",
	"dependencies": {
		"deepmerge": "^4.3.1",
		"load-script": "^2.0.0",
		"memoize-one": "^6.0.0",
		"vue-demi": "^0.14.10",
		"vue-types": "^5.1.3"
	},
	"peerDependencies": {
		"@vue/composition-api": "^1.0.0",
		"vue": "^2.6.0||^3.0.0"
	},
	"peerDependenciesMeta": {
		"@vue/composition-api": {
			"optional": true
		}
	},
	"devDependencies": {
		"@babel/core": "^7.25.2",
		"@babel/preset-env": "^7.25.4",
		"@rollup/plugin-alias": "^5.1.0",
		"@rollup/plugin-babel": "^6.0.4",
		"@rollup/plugin-commonjs": "^26.0.1",
		"@rollup/plugin-node-resolve": "^15.2.3",
		"@rollup/plugin-replace": "^5.0.7",
		"@rollup/plugin-terser": "^0.4.4",
		"@vue/compat": "^3.5.6",
		"@vue/compiler-sfc": "^3.5.6",
		"core-js": "^3.38.1",
		"rollup": "^2.79.1",
		"rollup-plugin-postcss": "^4.0.2",
		"rollup-plugin-sass": "^1.13.2",
		"rollup-plugin-vue": "^6.0.0",
		"sass": "^1.78.0",
		"typescript": "^5.6.2",
		"vue": "^3.5.6"
	}
}
