{
	"name": "@voltra/vue-player",
	"version": "0.0.8",
	"description": "A Vue port of react-player: components for playing a variety of URLs including file paths, YouTube, Facebook, Twitch, SoundCloud, Streamable, Vimeo, Wistia, DailyMotion",
	"type": "module",
	"main": "./dist/vue-player.umd.cjs",
	"umd:main": "./dist/vue-player.umd.cjs",
	"unpkg": "./dist/vue-player.umd.cjs",
	"module": "./dist/vue-player.js",
	"types": "./types/index.d.ts",
	"exports": {
		".": {
			"import": "./dist/vue-player.js",
			"require": "./dist/vue-player.umd.cjs"
		},
		"./index.css": "./dist/index.css"
	},
	"scripts": {
		"build": "vue-tsc -b && vite build",
		"clean": "rm -rf dist",
		"lint": "eslint --fix .",
		"preview": "vite preview",
		"watch": "vite"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Voltra/vue-player.git"
	},
	"keywords": [
		"vue",
		"media",
		"player",
		"video",
		"audio",
		"youtube",
		"facebook",
		"twitch",
		"soundcloud",
		"streamable",
		"vimeo",
		"wistia",
		"dailymotion",
		"hls",
		"dash",
		"vue-component"
	],
	"author": "Voltra <ludwig.guerin.98@gmx.fr>",
	"license": "MIT",
	"bugs": {
		"url": "https://github.com/Voltra/vue-player/issues"
	},
	"homepage": "https://voltra.github.io/vue-player",
	"dependencies": {
		"deepmerge": "^4.3.1",
		"memoize-one": "^6.0.0"
	},
	"peerDependencies": {
		"vue": "^3.0.0"
	},
	"devDependencies": {
		"@eslint/js": "^9.10.0",
		"@types/eslint__js": "^8.42.3",
		"@types/node": "^22.5.5",
		"@typescript-eslint/parser": "^8.6.0",
		"@vitejs/plugin-vue": "^5.1.2",
		"eslint": "^9.10.0",
		"eslint-plugin-vue": "^9.28.0",
		"typescript": "^5.6.2",
		"typescript-eslint": "^8.6.0",
		"vite": "^5.4.1",
		"vue": "^3.0.0",
		"vue-eslint-parser": "^9.4.3",
		"vue-tsc": "^2.0.29"
	}
}
