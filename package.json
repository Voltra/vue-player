{
	"name": "@voltra/vue-player",
	"version": "0.0.8",
	"description": "A Vue port of react-player: components for playing a variety of URLs including file paths, YouTube, Facebook, Twitch, SoundCloud, Streamable, Vimeo, Wistia, DailyMotion",
	"type": "module",
	"main": "./dist/vue-player.umd.cjs",
	"umd:main": "./dist/vue-player.umd.cjs",
	"unpkg": "./dist/vue-player.umd.cjs",
	"module": "./dist/vue-player.js",
	"types": "./types/index.d.ts",
	"exports": {
		".": {
			"import": "./dist/vue-player.js",
			"require": "./dist/vue-player.umd.cjs"
		},
		"./index.css": "./dist/index.css"
	},
	"scripts": {
		"watch": "vite",
		"build": "vue-tsc -b && vite build",
		"preview": "vite preview",
		"clean": "rm -rf dist"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Voltra/vue-player.git"
	},
	"keywords": [
		"vue",
		"media",
		"player",
		"video",
		"audio",
		"youtube",
		"facebook",
		"twitch",
		"soundcloud",
		"streamable",
		"vimeo",
		"wistia",
		"dailymotion",
		"hls",
		"dash",
		"vue-component"
	],
	"author": "Voltra <ludwig.guerin.98@gmx.fr>",
	"license": "MIT",
	"bugs": {
		"url": "https://github.com/Voltra/vue-player/issues"
	},
	"homepage": "https://voltra.github.io/vue-player",
	"dependencies": {
		"deepmerge": "^4.3.1",
		"memoize-one": "^6.0.0"
	},
	"peerDependencies": {
		"vue": "^3.0.0"
	},
	"devDependencies": {
		"@vitejs/plugin-vue": "^5.1.2",
		"typescript": "^5.5.3",
		"vite": "^5.4.1",
		"vue-tsc": "^2.0.29",
		"vue": "^3.0.0"
	}
}
